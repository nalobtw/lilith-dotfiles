# TLP: the settings live in /etc/tlp.conf itself (the file you edit by hand). Each KEY is replaced
# where it already exists (also when commented out), or appended. The original is kept once as
# /etc/tlp.conf.lilith-backup. Applies after a reboot or `sudo tlp start`.
# set_tlp <KEY> <value>
set_tlp() {
	if grep -q "^$1=" /etc/tlp.conf 2>/dev/null; then
		run_root sed -i "s|^$1=.*|$1=$2|" /etc/tlp.conf
	elif grep -q "^#$1=" /etc/tlp.conf 2>/dev/null; then
		run_root sed -i "0,/^#$1=.*/s||$1=$2|" /etc/tlp.conf
	else
		run_root sh -c "printf '%s=%s\\n' '$1' '$2' >> /etc/tlp.conf"
	fi
}

config_tlp() {
	step "TLP (/etc/tlp.conf)"
	if [ "$DRY" != 1 ] && [ ! -f /etc/tlp.conf ]; then
		warn "/etc/tlp.conf not found (is tlp installed? lilith-rice deps)"
		return
	fi
	[ -f /etc/tlp.conf.lilith-backup ] || run_root cp -a /etc/tlp.conf /etc/tlp.conf.lilith-backup
	run_root rm -f /etc/tlp.d/10-x1c7.conf          # the old drop-in of earlier versions
	set_tlp CPU_SCALING_GOVERNOR_ON_AC powersave
	set_tlp CPU_SCALING_GOVERNOR_ON_BAT powersave
	set_tlp CPU_ENERGY_PERF_POLICY_ON_AC balance_performance
	set_tlp CPU_ENERGY_PERF_POLICY_ON_BAT balance_power
	set_tlp CPU_BOOST_ON_AC 1
	set_tlp CPU_BOOST_ON_BAT 0
	set_tlp USB_AUTOSUSPEND 0                       # a mouse dongle must never be put to sleep
	set_tlp START_CHARGE_THRESH_BAT0 75             # battery care: charge between 75% and 80%
	set_tlp STOP_CHARGE_THRESH_BAT0 80
	ok "/etc/tlp.conf (governor, boost, USB autosuspend off, battery thresholds 75/80)"
}

# doas next to sudo, with a single rule for members of wheel.
config_doas() {
	step "doas"
	rule="permit persist :wheel"
	tmp=$(mktemp)
	printf '%s\n' "$rule" > "$tmp"
	if [ -f /etc/doas.conf ] && cmp -s "$tmp" /etc/doas.conf; then
		ok "/etc/doas.conf"
	elif command -v doas >/dev/null 2>&1 && ! doas -C "$tmp" >/dev/null 2>&1; then
		warn "doas rejected the rule; /etc/doas.conf left alone"
	else
		[ -f /etc/doas.conf ] && run_root cp -a /etc/doas.conf /etc/doas.conf.lilith-backup
		if run_root install -m 0400 -o root -g root "$tmp" /etc/doas.conf; then ok "/etc/doas.conf: $rule"
		else bad "could not write /etc/doas.conf"; fi
	fi
	rm -f "$tmp"
}

# set_rc <file> <KEY> <value>: set KEY=value in a root-owned config file (replace or append).
set_rc() {
	if grep -q "^#\?$2=" "$1" 2>/dev/null; then
		run_root sed -i "s|^#\?$2=.*|$2=$3|" "$1"
	else
		run_root sh -c "printf '%s=%s\\n' '$2' '$3' >> '$1'"
	fi
}

# Timezone and the UK console keymap. (Void musl has no locale support, so there is no locale step.)
config_locale() {
	step "Timezone and keymap"
	if [ "$(readlink /etc/localtime 2>/dev/null)" = "/usr/share/zoneinfo/$TIMEZONE" ]; then
		ok "timezone $TIMEZONE"
	elif [ -e "/usr/share/zoneinfo/$TIMEZONE" ] && run_root ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime; then
		ok "timezone set to $TIMEZONE"
	else
		bad "could not set the timezone (is tzdata installed?)"
	fi
	set_rc /etc/rc.conf TIMEZONE "$TIMEZONE" && set_rc /etc/rc.conf KEYMAP "\"$KEYMAP\"" && ok "console keymap $KEYMAP (rc.conf)"
}

# The power menu runs zzz / reboot / poweroff through sudo without a password prompt,
# only for members of wheel and only for those three commands. The rule is validated first.
config_power() {
	step "Power menu permissions"
	if ! command -v visudo >/dev/null 2>&1; then
		warn "visudo not found; the power menu will fall back to loginctl"
		return
	fi
	cmds=""
	for c in zzz reboot poweroff; do
		path=$(command -v "$c" 2>/dev/null) || continue
		real=$(readlink -f "$path")
		cmds="$cmds${cmds:+, }$path"
		[ "$real" != "$path" ] && cmds="$cmds, $real"
	done
	[ -n "$cmds" ] || { warn "zzz/reboot/poweroff not found"; return; }
	tmp=$(mktemp)
	printf '# lilith-rice: the power menu may suspend, reboot and power off without a password\n%%wheel ALL=(root) NOPASSWD: %s\n' "$cmds" > "$tmp"
	if run_root visudo -cf "$tmp" >/dev/null 2>&1; then
		if [ -f /etc/sudoers.d/10-lilith-power ] && cmp -s "$tmp" /etc/sudoers.d/10-lilith-power; then
			ok "/etc/sudoers.d/10-lilith-power"
		elif run_root install -m 0440 -o root -g root "$tmp" /etc/sudoers.d/10-lilith-power; then
			ok "/etc/sudoers.d/10-lilith-power installed"
		else
			bad "could not install the sudoers rule"
		fi
	else
		warn "the generated sudoers rule did not validate; skipped"
	fi
	rm -f "$tmp"
}

# PipeWire as the Void handbook describes: pipewire launches wireplumber and
# pipewire-pulse itself (right order), and ALSA apps are routed through it.
config_audio() {
	step "Audio (PipeWire)"
	pw=/etc/pipewire/pipewire.conf.d
	alsa=/etc/alsa/conf.d
	run_root mkdir -p "$pw" "$alsa"
	for pair in \
	  "/usr/share/examples/wireplumber/10-wireplumber.conf $pw/10-wireplumber.conf" \
	  "/usr/share/examples/pipewire/20-pipewire-pulse.conf $pw/20-pipewire-pulse.conf" \
	  "/usr/share/alsa/alsa.conf.d/50-pipewire.conf $alsa/50-pipewire.conf" \
	  "/usr/share/alsa/alsa.conf.d/99-pipewire-default.conf $alsa/99-pipewire-default.conf"
	do
		set -- $pair
		if [ -L "$2" ] || [ -e "$2" ]; then
			ok "$2"
		elif [ "$DRY" != 1 ] && [ ! -e "$1" ]; then
			warn "$1 missing (are pipewire and alsa-pipewire installed?)"
		elif run_root ln -s "$1" "$2"; then
			ok "$2 linked"
		else
			bad "could not link $2"
		fi
	done
}

config_shell() {
	step "Login shell"
	zsh_path=$(command -v zsh || true)
	if [ -z "$zsh_path" ]; then
		warn "zsh not installed yet"
	elif [ "$(login_shell)" = "$zsh_path" ]; then
		ok "zsh is your login shell"
	elif run_root usermod -s "$zsh_path" "$USER"; then
		ok "login shell set to $zsh_path"
	else
		bad "could not change login shell"
	fi
}

config_lilith() {
	step "lilith configuration"
	if [ ! -d "$LILITH_SRC" ]; then
		bad "lilith source missing: run 'lilith-rice source'"
	else
		mkdir -p "$LILITH_SRC/config"
		if cp -f "$RICE_HOME/lilith/config.h" "$LILITH_SRC/config.h" \
		   && cp -f "$RICE_HOME"/lilith/config/*.h "$LILITH_SRC/config/"; then
			ok "config copied into $LILITH_SRC"
		else
			bad "could not copy lilith config"
		fi
	fi
	# Always generate the palette outputs: foot.ini includes colors.ini, which must exist.
	"$RICE_HOME/bin/lilith-theme" --no-build || bad "theme generation failed"
}

cmd_config() {
	config_dotfiles
	config_system
	config_tlp
	config_doas
	config_locale
	config_power
	config_audio
	config_shell
	config_lilith
}

cmd_build() {
	step "Build lilith"
	if [ ! -d "$LILITH_SRC" ]; then
		bad "source missing: run 'lilith-rice source'"
		return
	fi
	if ! pkg-config --exists wlroots-0.19 2>/dev/null; then
		bad "wlroots-0.19 development files not found (package: wlroots0.19-devel)"
		return
	fi
	"$RICE_HOME/bin/lilith-theme" --no-build >/dev/null 2>&1
	# Always start from the stock sources, then try our patch (bar modules, per-device scrolling).
	patchfile="$RICE_HOME/lilith/patches/0001-lilith-rice.patch"
	git -C "$LILITH_SRC" checkout -q -- src 2>/dev/null
	patched=0
	if patch -d "$LILITH_SRC" -p1 -F0 --dry-run -s < "$patchfile" >/dev/null 2>&1 \
	   && patch -d "$LILITH_SRC" -p1 -F0 -s < "$patchfile"; then
		patched=1
	else
		warn "patch does not apply to this lilith version: building stock lilith (logo, title and REC stay empty)"
	fi
	if make -C "$LILITH_SRC" >"$LILITH_SRC/build.log" 2>&1; then
		[ "$patched" = 1 ] && ok "patch applied (bar logo, window title, REC badge, per-device scrolling)"
		install -Dm755 "$LILITH_SRC/lilith" "$HOME/.local/bin/lilith"
		ok "lilith installed to ~/.local/bin/lilith"
	elif [ "$patched" = 1 ]; then
		warn "patched build failed; building stock lilith instead (see $LILITH_SRC/build.log)"
		cp "$LILITH_SRC/build.log" "$LILITH_SRC/build-patched.log"
		git -C "$LILITH_SRC" checkout -q -- src
		if make -C "$LILITH_SRC" >"$LILITH_SRC/build.log" 2>&1; then
			install -Dm755 "$LILITH_SRC/lilith" "$HOME/.local/bin/lilith"
			ok "stock lilith installed (the patch failed to compile: build-patched.log)"
		else
			bad "build failed; last lines of $LILITH_SRC/build.log:"
			tail -n 15 "$LILITH_SRC/build.log" | sed 's/^/        /'
		fi
	else
		bad "build failed; last lines of $LILITH_SRC/build.log:"
		tail -n 15 "$LILITH_SRC/build.log" | sed 's/^/        /'
	fi
}

# ---------------------------------------------------------------- 9. verify
cmd_verify() {
	step "Verify"
	for c in lilith lilith-session lilith-menu lilith-status lilith-theme lilith-shot lilith-record \
	         foot zsh yazi fzf wmenu wpctl brightnessctl grim slurp wf-recorder wl-copy cliphist \
	         nmtui nmcli bluetoothctl dbus-run-session pipewire curl; do
		expect bad "$c" "command not found" command -v "$c"
	done
	for s in $(list_items "$RICE_HOME/packages/services.txt"); do
		if [ ! -e "/var/service/$s" ]; then
			bad "service $s: not enabled"
		elif sv status "/var/service/$s" 2>/dev/null | grep -q '^run:'; then
			ok "service $s: running"
		else
			warn "service $s: enabled, not running yet"
		fi
	done
	expect warn "NetworkManager enabled" "run 'lilith-rice network' as the last step" \
		test -e /var/service/NetworkManager
	for g in video network bluetooth; do
		expect warn "you are in group $g" "this script never changes groups; add yourself if you want it" in_group "$g"
	done
	if [ -e /var/service/acpid ]; then
		warn "acpid is enabled but elogind handles lid/power (turn it off: sudo rm /var/service/acpid)"
	fi
	expect bad "elogind lid/power config" "run 'lilith-rice config'" \
		test -f /etc/elogind/logind.conf.d/10-lilith.conf
	expect bad "PipeWire launches wireplumber" "run 'lilith-rice config'" \
		test -L /etc/pipewire/pipewire.conf.d/10-wireplumber.conf
	expect bad "PipeWire launches pipewire-pulse" "run 'lilith-rice config'" \
		test -L /etc/pipewire/pipewire.conf.d/20-pipewire-pulse.conf
	expect bad "ALSA routed through PipeWire" "run 'lilith-rice config'" \
		test -L /etc/alsa/conf.d/50-pipewire.conf
	expect warn "lilith-select (crosshair)" "run 'lilith-rice select'; Print falls back to slurp" command -v lilith-select
	for c in yazi vis pfetch librewolf firefox flatpak mpv drift pipemixer ani-cli moviebox-tui rimg zoxide atuin udiskie ouch \
	         genact ascii-splash clangd clang-format clang-tidy rust-analyzer rustfmt cargo-clippy lua-language-server stylua \
	         bash-language-server shellcheck shfmt basedpyright-langserver black ruff; do
		expect warn "$c" "run lilith-rice ... (see lilith-rice help)" command -v "$c"
	done
	for fam in "Gallant" "JetBrains Mono" "Symbols Nerd Font" "Noto Color Emoji"; do
		expect warn "font $fam" "run 'lilith-rice fonts'" fc_has "$fam"
	done
	expect warn "cursor theme in settings.conf" "run 'lilith-rice cursors'" test -d "$HOME/.local/share/icons/$(sed -n 's/^cursor="\(.*\)"$/\1/p' "$CONF/lilith-rice/settings.conf" 2>/dev/null | head -n1)"
	expect warn "icon theme in settings.conf" "run 'lilith-rice icons'" icon_installed "$(sed -n 's/^icons="\(.*\)"$/\1/p' "$CONF/lilith-rice/settings.conf" 2>/dev/null | head -n1)"
	expect warn "Vis plugins cloned (vis-plug)" "start vis once, wait, restart it" test -d "$HOME/.cache/vis-plug/plugins"
	expect warn "thinkpad_acpi kernel module" "run 'lilith-rice config' (loads it at boot)" sh -c 'grep -q "^thinkpad_acpi " /proc/modules || [ -d /sys/devices/platform/thinkpad_acpi ]'
	expect warn "TLP charge thresholds in /etc/tlp.conf" "run 'lilith-rice config'" grep -q '^START_CHARGE_THRESH_BAT0=' /etc/tlp.conf
	expect warn "zsh plugins" "run 'lilith-rice shell'" test -d "$ZSH_PLUGINS/fast-syntax-highlighting"
	expect warn "flathub remote" "run 'lilith-rice flatpak'" sh -c 'flatpak --user remotes 2>/dev/null | grep -q flathub'
	expect warn "power menu rule" "run 'lilith-rice config'" test -f /etc/sudoers.d/10-lilith-power
	expect warn "wallpaper $WALLPAPER_FILE" "run 'lilith-rice wallpapers'" has_wallpapers
	expect bad "settings.conf" "run 'lilith-rice config'" test -f "$CONF/lilith-rice/settings.conf"
	expect bad "colors.conf" "run 'lilith-rice config'" test -f "$CONF/lilith-rice/colors.conf"
	expect warn "wallust" "run 'lilith-rice wallust'" command -v wallust
	expect warn "colours made by wallust" "run: lilith-wall <image>" test -f "$CONF/lilith-rice/.colors-from-wallust"
	cfg_scale=$( . "$CONF/lilith-rice/settings.conf" 2>/dev/null; echo "${scale:-1}" )
	built_scale=$(sed -n 's/^#define T_SCALE  *\([0-9.]*\)f.*/\1/p' "$LILITH_SRC/theme.h" 2>/dev/null)
	expect warn "scale $cfg_scale is what lilith was built with" "run: lilith-theme, then restart the session (built: ${built_scale:-none})" test "${built_scale%.0}" = "${cfg_scale%.0}"
	expect warn "installed lilith is newer than the last theme change" "settings changed but not rebuilt: run lilith-theme, then restart the session" test "$HOME/.local/bin/lilith" -nt "$LILITH_SRC/theme.h"
	expect warn "bar logo/title patch built in" "see build.log; the stock bar is in use" grep -q bar_title_update "$LILITH_SRC/src/bar.h"
	expect warn "doas rule" "run 'lilith-rice config'" test -f /etc/doas.conf
	expect warn "ly login manager" "run 'lilith-rice ly'" test -e /var/service/ly
	expect warn "timezone $TIMEZONE" "run 'lilith-rice config'" test "$(readlink /etc/localtime)" = "/usr/share/zoneinfo/$TIMEZONE"
	expect bad "foot colours" "run 'lilith-theme'" test -f "$CONF/foot/colors.ini"
	expect bad "monospace font" "fontconfig has no monospace font" fc-match monospace
	expect warn "login shell is zsh" "run 'lilith-rice config'" \
		test "$(login_shell)" = "$(command -v zsh || echo none)"
	if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
		ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
	else
		warn "XDG_RUNTIME_DIR unset (normal outside a tty login; check again on tty1)"
	fi
	printf '\n'
	if [ "$PROBLEMS" -eq 0 ]; then
		printf "${G}${B}all checks passed${Z}\n"
	else
		printf "${R}${B}%s problem(s) found${Z}\n" "$PROBLEMS"
	fi
	[ "$PROBLEMS" -eq 0 ]
}

