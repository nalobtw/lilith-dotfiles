	soft cmd_dev      "some development tools failed; retry later with: lilith-rice dev"
	soft cmd_cursors  "cursors failed; retry later with: lilith-rice cursors"
	soft cmd_icons    "icon themes failed; retry later with: lilith-rice icons"
	cmd_verify
	rc=$?
	cat <<MSG

${B}Next:${Z}
  1. lilith-rice network   (switches Wi-Fi to NetworkManager; then use nmtui)
  2. Reboot (so the services, elogind and Ly start).
  3. Log in at the Ly screen and pick \"lilith\" (tty1 also still starts the desktop by itself).
  4. Super+/ shows every key binding.
MSG
	return $rc
}

cmd_update() {
	step "Update"
	git -C "$RICE_HOME" pull --ff-only || die "git pull failed (local changes?)"
	cmd_source
	cmd_config
	cmd_build
	cmd_verify
}

# ---------------------------------------------------------------- 11. dispatch
case "${1:-help}" in
	install)    cmd_install ;;
	deps)       cmd_deps ;;
	packages)   cmd_packages ;;
	services)   cmd_services ;;
	bluetooth)  cmd_bluetooth ;;
	fonts)      cmd_fonts ;;
	source)     cmd_source ;;
	config)     cmd_config ;;
	build)      cmd_build ;;
	wallpapers) cmd_wallpapers ;;
	wallust)    cmd_wallust ;;
	ly)         cmd_ly ;;
	files)      cmd_files ;;
	shell)      cmd_shell ;;
	browsers)   cmd_browsers ;;
	flatpak)    cmd_flatpak ;;
	media)      cmd_media ;;
	toys)       cmd_toys ;;
	dev)        cmd_dev ;;
	cursors)    cmd_cursors ;;
	icons)      cmd_icons ;;
	select)     cmd_select ;;
	network)    cmd_network ;;
	theme)      exec "$RICE_HOME/bin/lilith-theme" ;;
	verify)     cmd_verify ;;
	update)     cmd_update ;;
	help|-h|--help) usage ;;
	*) usage >&2; exit 2 ;;
esac
