#!/bin/sh
# ======================================================================
#  lilith-ly-bg — turn the wallpaper into the Ly login background
# ----------------------------------------------------------------------
#  usage: lilith-ly-bg [image]        (default: wallpaper= from settings.conf)
#  Writes ~/.local/share/lilith-rice/login.dur, a durdraw v7 file (gzipped JSON) that Ly's
#  dur_file animation shows behind the login box. Each text cell holds two pixels
#  (upper half block), in the 256-colour cube, so it looks like chunky pixel art.
#  Size = the console in cells: ly_cols x ly_rows in settings.conf (default 320x90, which is a
#  2560x1440 screen with the standard 8x16 console font). Needs ImageMagick and python3.
#  lilith-theme runs this whenever the wallpaper changes.
# ======================================================================

set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/lilith-rice"
OUT="${LY_BG:-$HOME/.local/share/lilith-rice/login.dur}"
ly_cols=320 ly_rows=90 wallpaper=""
# shellcheck disable=SC1090
[ -f "$CONF/settings.conf" ] && . "$CONF/settings.conf"
img="${1:-$wallpaper}"

[ -f "$img" ] || { echo "lilith-ly-bg: no wallpaper image: ${img:-none}" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "lilith-ly-bg: python3 is not installed" >&2; exit 1; }
if command -v magick >/dev/null 2>&1; then IM=magick
elif command -v convert >/dev/null 2>&1; then IM=convert
else echo "lilith-ly-bg: ImageMagick is not installed" >&2; exit 1; fi

mkdir -p "$(dirname "$OUT")"
w=$ly_cols
h=$((ly_rows * 2))        # two pixels per cell
# cover the screen: scale up, crop the middle, raw 8-bit RGB on stdout
$IM "$img" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" -depth 8 rgb:- \
| python3 -c '
import gzip, json, sys
w, h, out = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
raw = sys.stdin.buffer.read()
if len(raw) != w * h * 3:
    sys.exit("lilith-ly-bg: unexpected image data (%d bytes, wanted %d)" % (len(raw), w * h * 3))
DIM = 0.8                                     # a little darker so the login box stays readable
def idx(i):
    r, g, b = (min(255, int(raw[i + k] * DIM)) for k in range(3))
    q = lambda v: round(v / 255 * 5)
    return 16 + 36 * q(r) + 6 * q(g) + q(b)   # xterm 6x6x6 colour cube
rows = h // 2
colormap = [[[idx(((2 * y) * w + x) * 3), idx(((2 * y + 1) * w + x) * 3)] for y in range(rows)] for x in range(w)]
frame = {"frameNumber": 1, "delay": 0.0, "contents": ["\u2580" * w] * rows, "colorMap": colormap}
movie = {"DurMovie": {"formatVersion": 7, "colorFormat": "256", "encoding": "utf-8", "framerate": 1.0,
                      "columns": w, "lines": rows, "frames": [frame]}}
with gzip.open(out, "wt", encoding="utf-8") as f:
    json.dump(movie, f)
' "$w" "$h" "$OUT" && echo "lilith-ly-bg: $OUT ($ly_cols x $ly_rows)"
