#!/bin/sh
# ======================================================================
#  lilith-level — change volume / brightness and remember it across reboots
# ----------------------------------------------------------------------
#  usage: lilith-level volume up|down|mute
#         lilith-level brightness up|down
#         lilith-level restore          (run at login by lilith-autostart)
#  The media keys call this. The last values are kept in
#  ~/.local/state/lilith-rice/ and put back at the next login.
# ======================================================================

set -u

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/lilith-rice"
SINK="@DEFAULT_AUDIO_SINK@"
mkdir -p "$STATE"

save_volume() {
	# "Volume: 0.45" or "Volume: 0.45 [MUTED]"  ->  0.45 and muted/unmuted
	line=$(wpctl get-volume "$SINK" 2>/dev/null) || return 0
	printf '%s\n' "$line" | awk '{ print $2 }' > "$STATE/volume"
	case "$line" in *MUTED*) echo 1 > "$STATE/mute" ;; *) echo 0 > "$STATE/mute" ;; esac
}

save_brightness() {
	# brightnessctl -m: device,class,value,percent%,max
	brightnessctl -m 2>/dev/null | cut -d, -f4 > "$STATE/brightness"
}

case "${1:-}:${2:-}" in
	volume:up)       wpctl set-volume -l 1.0 "$SINK" 5%+; save_volume ;;
	volume:down)     wpctl set-volume "$SINK" 5%-;        save_volume ;;
	volume:mute)     wpctl set-mute "$SINK" toggle;       save_volume ;;
	brightness:up)   brightnessctl -q set 10%+;           save_brightness ;;
	brightness:down)
		brightnessctl -q set 10%-
		# never let the screen go fully dark
		[ "$(brightnessctl -m 2>/dev/null | cut -d, -f4)" = "0%" ] && brightnessctl -q set 1%
		save_brightness ;;
	restore:*)
		if [ -s "$STATE/brightness" ]; then brightnessctl -q set "$(cat "$STATE/brightness")"; fi
		# PipeWire needs a moment after login
		i=0
		while [ "$i" -lt 20 ]; do
			wpctl status >/dev/null 2>&1 && break
			sleep 0.5
			i=$((i + 1))
		done
		if [ -s "$STATE/volume" ]; then wpctl set-volume "$SINK" "$(cat "$STATE/volume")"; fi
		if [ "$(cat "$STATE/mute" 2>/dev/null)" = 1 ]; then wpctl set-mute "$SINK" 1; fi ;;
	*) echo "usage: lilith-level volume up|down|mute | brightness up|down | restore" >&2; exit 2 ;;
esac
