#!/bin/sh
# ======================================================================
#  lilith-wall — use an image as the wallpaper and make its colours
# ----------------------------------------------------------------------
#  usage: lilith-wall <image>
#  Sets wallpaper= in settings.conf and runs wallust, which writes colors.conf from the
#  image (and recolours open terminals). Then run lilith-theme to apply it everywhere.
#  If wallust fails, colors.conf is left untouched: colours never fall back to a fixed set.
# ======================================================================

set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/lilith-rice"
img="${1:-}"

[ -f "$img" ] || { echo "lilith-wall: no such image: $img" >&2; exit 2; }
command -v wallust >/dev/null 2>&1 || { echo "lilith-wall: wallust is not installed (run: lilith-rice wallust)" >&2; exit 1; }
img=$(readlink -f "$img")

before=$(cksum < "$CONF/colors.conf" 2>/dev/null)
if ! wallust run "$img" >/dev/null 2>&1; then
	echo "lilith-wall: wallust failed on $img; colours unchanged (try: wallust run $img)" >&2
	exit 1
fi
after=$(cksum < "$CONF/colors.conf" 2>/dev/null)
[ -f "$CONF/colors.conf" ] || { echo "lilith-wall: wallust did not write $CONF/colors.conf (check ~/.config/wallust/wallust.toml)" >&2; exit 1; }
[ "$before" != "$after" ] || echo "lilith-wall: colours are the same as before (same image or a very similar one)" >&2

if grep -q '^wallpaper=' "$CONF/settings.conf"; then
	sed -i "s|^wallpaper=.*|wallpaper=\"$img\"|" "$CONF/settings.conf"
else
	printf 'wallpaper="%s"\n' "$img" >> "$CONF/settings.conf"
fi
echo "lilith-wall: $img"
