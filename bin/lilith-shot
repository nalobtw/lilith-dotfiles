#!/bin/sh
# ======================================================================
#  lilith-shot — screenshot to file + clipboard (lilith-select or slurp, then grim)
# ----------------------------------------------------------------------
#  usage: lilith-shot region | full | geometry
#  region / full  save a PNG to ~/Pictures/screenshots and copy it to the
#                 clipboard; the saved path is printed (no notification).
#  geometry       only print the selected area ("x,y WxH"); used by lilith-record.
#  The selector is lilith-select (crosshair) when built, else slurp. Colours come from colors.conf
#  (SHOT_COLOR overrides the accent). Esc or a right click cancels.
# ======================================================================

set -u

DIR="$HOME/Pictures/screenshots"
COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/lilith-rice/colors.conf"

need() {
	command -v "$1" >/dev/null 2>&1 || { echo "lilith-shot: '$1' is not installed" >&2; exit 1; }
}

# select_area: print the chosen "x,y WxH". Prefers lilith-select (dimmed screen, cross cursor,
# lines across the screen, selection box, all in the accent colour); falls back to slurp.
select_area() {
	pgrep -x lilith-select >/dev/null 2>&1 && return 1   # a selection is already open: do not stack another
	pgrep -x slurp >/dev/null 2>&1 && return 1
	accent=ffffff background=000000
	# shellcheck disable=SC1090
	[ -f "$COLORS" ] && . "$COLORS"
	accent=${accent#\#}
	if command -v lilith-select >/dev/null 2>&1; then
		lilith-select -c "${SHOT_COLOR:-$accent}" -d 0.45
	else
		need slurp
		slurp -b "#${background#\#}99" -c "#${SHOT_COLOR:-$accent}ff" -w 2
	fi
}

case "${1:-region}" in
	geometry)
		select_area || exit 1
		exit 0
		;;
	full | region)
		need grim
		mkdir -p "$DIR"
		file="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"
		if [ "$1" = full ]; then
			grim "$file" || exit 1
		else
			geometry=$(select_area) || exit 0   # Esc: cancelled, not an error
			grim -g "$geometry" "$file" || exit 1
		fi
		command -v wl-copy >/dev/null 2>&1 && wl-copy < "$file"
		echo "$file"
		;;
	*)
		echo "usage: lilith-shot region|full|geometry" >&2
		exit 2
		;;
esac
