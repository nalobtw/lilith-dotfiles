#!/bin/sh
# ======================================================================
#  lilith-theme — apply settings.conf and colors.conf everywhere
# ----------------------------------------------------------------------
#  usage:  lilith-theme             generate + recolour + rebuild the compositor
#          lilith-theme --no-build  generate + recolour only
#
#  Input   ~/.config/lilith-rice/settings.conf   scale, font, wallpaper, cursor
#          ~/.config/lilith-rice/colors.conf     colours, written by wallust
#  Output  compositor   $LILITH_SRC/theme.h (borders, bar, wallpaper, scale, font)
#          foot         ~/.config/foot/colors.ini (colours + font), open terminals live
#          yazi         ~/.config/yazi/theme.toml
#          Vis          nothing to write: it uses the terminal palette, which foot gets from here
#          GTK 3 / 4    gtk.css (colours) and settings.ini (font, dark, cursor, icons)
#          cursor       ~/.icons/default/index.theme
#          Ly           the login background (lilith-ly-bg)
#  The compositor part is compiled in: it needs the rebuild and a session restart
#  (Super+Shift+Q). Everything else updates at once.
# ======================================================================
set -eu

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
SETTINGS="${SETTINGS:-$CONF/lilith-rice/settings.conf}"
COLORS="${COLORS:-$CONF/lilith-rice/colors.conf}"
LILITH_SRC="${LILITH_SRC:-$HOME/.local/src/lilith}"
BUILD=1
[ "${1:-}" = "--no-build" ] && BUILD=0

die() { printf 'lilith-theme: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- 1. read + validate
[ -f "$SETTINGS" ] || die "settings not found: $SETTINGS (run: lilith-rice config)"
[ -f "$COLORS" ] || die "colours not found: $COLORS (run: lilith-rice config)"
# shellcheck disable=SC1090
. "$SETTINGS"
# shellcheck disable=SC1090
. "$COLORS"

NAMES="background foreground accent urgent dim color0 color1 color2 color3 color4 color5 color6 color7 \
color8 color9 color10 color11 color12 color13 color14 color15"
for n in $NAMES; do          # wallust writes #rrggbb: drop the '#', then require 6 hex digits
	eval "v=\${$n:-}"
	v=${v#\#}
	[ -n "$v" ] || die "missing '$n' in $COLORS"
	case "$v" in
		[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
		*) die "bad colour for '$n': '$v' (want 6 hex digits)" ;;
	esac
	eval "$n=\$v"
done

font="${font:-monospace}"
font_size="${font_size:-12}"
case "$font_size" in ''|*[!0-9]*) die "bad font_size '$font_size' in $SETTINGS (want a whole number)" ;; esac
scale="${scale:-1}"
case "$scale" in
	[0-9] | [0-9].[0-9] | [0-9].[0-9][0-9]) ;;
	*) die "bad scale '$scale' in $SETTINGS (want e.g. 1, 1.25, 1.33, 1.5, 2)" ;;
esac
case "$scale" in *.*) ;; *) scale="$scale.0" ;; esac       # C wants 1.0f, not 1f
cursor="${cursor:-catppuccin-mocha-rosewater-cursors}"
icons="${icons:-Pixora}"
cursor_size="${cursor_size:-24}"
case "$cursor_size" in ''|*[!0-9]*) die "bad cursor_size '$cursor_size' in $SETTINGS" ;; esac
wallpaper="${wallpaper:-}"
if [ -n "$wallpaper" ] && [ ! -f "$wallpaper" ]; then      # saved as .png when settings say .jpg, or the reverse
	for ext in jpg jpeg png; do
		[ -f "${wallpaper%.*}.$ext" ] && { wallpaper="${wallpaper%.*}.$ext"; break; }
	done
fi
if [ -n "$wallpaper" ] && [ ! -f "$wallpaper" ]; then
	printf 'lilith-theme: wallpaper not found, ignoring: %s\n' "$wallpaper" >&2
	wallpaper=""
fi

# mix <from> <to> <percent>: the colour <percent>% of the way from -> to (for surfaces and dim text)
mix() {
	out=""
	for pos in 1-2 3-4 5-6; do
		a=$((0x$(printf %s "$1" | cut -c$pos)))
		b=$((0x$(printf %s "$2" | cut -c$pos)))
		out="$out$(printf '%02x' $(( a + (b - a) * $3 / 100 )))"
	done
	printf %s "$out"
}
surface=$(mix "$background" "$foreground" 8)
muted=$(mix "$background" "$foreground" 14)
quiet=$(mix "$background" "$foreground" 55)

# ---------------------------------------------------------------- 2. compositor header
# lilith's Makefile does not track theme.h, so touch config.h when it changes.
# The WAL_* / WALR_* names are the ones ceapeapea's lilith-dotfiles use.
if [ -d "$LILITH_SRC" ]; then
	tmp="$LILITH_SRC/theme.h.new"
	{
		printf '/* Generated by lilith-theme from settings.conf and colors.conf. Do not edit. */\n'
		printf '#ifndef LILITH_THEME_H\n#define LILITH_THEME_H\n\n'
		printf '#define WAL_WALLPAPER "%s"\n#define T_SCALE %sf\n#define T_BAR_FONT "%s:size=%s"\n\n' \
			"$wallpaper" "$scale" "$font" "$font_size"
		for pair in "BG:$background" "FG:$foreground" "CURSOR:$foreground" "ACCENT:$accent" "ACCENT2:$color2" "URGENT:$urgent" "DIM:$dim"; do
			k=${pair%%:*}; v=${pair#*:}
			printf '#define WAL_%s COLOR(0x%sff)\n#define WALR_%s 0x%sff\n' "$k" "$v" "$k" "$v"
		done
		printf '#define WAL_BG_CLEAR COLOR(0x%s00)\n#define WALR_BG_CLEAR 0x%s00\n' "$background" "$background"
		printf '#define WAL_FG_CLEAR COLOR(0x%s00)\n#define WALR_FG_CLEAR 0x%s00\n' "$foreground" "$foreground"
		printf '#define WAL_BG_DIM COLOR(0x%s67)\n#define WALR_BG_DIM 0x%s67\n\n' "$background" "$background"
		i=0
		while [ $i -le 15 ]; do
			eval "c=\$color$i"
			printf '#define WAL_COLOR%s COLOR(0x%sff)\n' "$i" "$c"
			i=$((i + 1))
		done
		printf '\n#endif\n'
	} > "$tmp"
	if cmp -s "$tmp" "$LILITH_SRC/theme.h" 2>/dev/null; then
		rm -f "$tmp"
	else
		mv "$tmp" "$LILITH_SRC/theme.h"
		[ -f "$LILITH_SRC/config.h" ] && touch "$LILITH_SRC/config.h"
	fi
else
	printf 'lilith-theme: %s missing, skipping compositor header\n' "$LILITH_SRC" >&2
fi

# ---------------------------------------------------------------- 3. foot (colours + font)
# Newer foot calls the colour section [colors-dark], older foot [colors]; ask foot itself.
FOOT_COLORS="$CONF/foot/colors.ini"
write_foot() {
	{
		printf '# Generated by lilith-theme. Do not edit.\n'
		printf '[main]\nfont=%s:size=%s, monospace:size=%s\n\n' "$font" "$font_size" "$font_size"
		printf '[%s]\nbackground=%s\nforeground=%s\n' "$1" "$background" "$foreground"
		i=0
		while [ $i -le 7 ]; do
			eval "r=\$color$i; b=\$color$((i + 8))"
			printf 'regular%s=%s\nbright%s=%s\n' "$i" "$r" "$i" "$b"
			i=$((i + 1))
		done
	} > "$FOOT_COLORS"
}
mkdir -p "$(dirname "$FOOT_COLORS")"
write_foot colors-dark
if command -v foot >/dev/null 2>&1 && ! foot --check-config >/dev/null 2>&1; then
	write_foot colors
	foot --check-config >/dev/null 2>&1 || { write_foot colors-dark; printf 'lilith-theme: foot reports a config problem (foot --check-config)\n' >&2; }
fi

# ---------------------------------------------------------------- 4. yazi (no icons: colour tells things apart)
mkdir -p "$CONF/yazi"
cat > "$CONF/yazi/theme.toml" <<TOML
# Generated by lilith-theme from colors.conf. Do not edit.
[mgr]
cwd             = { fg = "#$accent", bold = true }
hovered         = { fg = "#$background", bg = "#$accent" }
preview_hovered = { underline = true }
find_keyword    = { fg = "#$color3", bold = true, underline = true }
find_position   = { fg = "#$color5", bold = true }
marker_selected = { fg = "#$background", bg = "#$color2" }
marker_copied   = { fg = "#$background", bg = "#$color3" }
marker_cut      = { fg = "#$background", bg = "#$urgent" }
marker_marked   = { fg = "#$background", bg = "#$color5" }
tab_active      = { fg = "#$background", bg = "#$accent" }
tab_inactive    = { fg = "#$foreground", bg = "#$muted" }
border_style    = { fg = "#$dim" }

[mode]
normal_main = { fg = "#$background", bg = "#$accent", bold = true }
normal_alt  = { fg = "#$accent", bg = "#$muted" }
select_main = { fg = "#$background", bg = "#$color2", bold = true }
select_alt  = { fg = "#$color2", bg = "#$muted" }
unset_main  = { fg = "#$background", bg = "#$urgent", bold = true }
unset_alt   = { fg = "#$urgent", bg = "#$muted" }

[status]
overall   = { fg = "#$foreground", bg = "#$surface" }
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }
perm_type  = { fg = "#$color2" }
perm_read  = { fg = "#$color3" }
perm_write = { fg = "#$urgent" }
perm_exec  = { fg = "#$color6" }
perm_sep   = { fg = "#$dim" }

[filetype]
rules = [
	{ mime = "image/*",                       fg = "#$color5" },
	{ mime = "{audio,video}/*",               fg = "#$color6" },
	{ mime = "application/{,g}zip",           fg = "#$color3" },
	{ mime = "application/{tar,bzip*,7z*,xz,rar}", fg = "#$color3" },
	{ mime = "application/{pdf,doc,rtf}",     fg = "#$foreground" },
	{ url = "*", is = "orphan",               fg = "#$urgent", underline = true },
	{ url = "*", is = "link",                 fg = "#$color6", italic = true },
	{ url = "*", is = "exec",                 fg = "#$color2", bold = true },
	{ url = "*/",                             fg = "#$accent", bold = true },
	{ url = "*",                              fg = "#$foreground" },
]

# No icons at all: folders are bold and accent-coloured, links italic, executables green.
[icon]
globs = []
dirs  = []
files = []
exts  = []
conds = []
TOML

# ---------------------------------------------------------------- 5. GTK 3 / 4 (colours, font, cursor) and the X11 cursor
for v in 3.0 4.0; do
	mkdir -p "$CONF/gtk-$v"
	cat > "$CONF/gtk-$v/settings.ini" <<INI
# Generated by lilith-theme. Do not edit.
[Settings]
gtk-application-prefer-dark-theme=1
gtk-font-name=$font 11
gtk-cursor-theme-name=$cursor
gtk-icon-theme-name=$icons
gtk-cursor-theme-size=$cursor_size
INI
	cat > "$CONF/gtk-$v/gtk.css" <<CSS
/* Generated by lilith-theme from colors.conf. Do not edit. Square corners, wallpaper colours. */
@define-color accent_color #$accent;
@define-color accent_bg_color #$accent;
@define-color accent_fg_color #$background;
@define-color destructive_bg_color #$urgent;
@define-color destructive_fg_color #$background;
@define-color window_bg_color #$background;
@define-color window_fg_color #$foreground;
@define-color view_bg_color #$background;
@define-color view_fg_color #$foreground;
@define-color headerbar_bg_color #$surface;
@define-color headerbar_fg_color #$foreground;
@define-color headerbar_border_color #$dim;
@define-color card_bg_color #$surface;
@define-color card_fg_color #$foreground;
@define-color popover_bg_color #$surface;
@define-color popover_fg_color #$foreground;
@define-color sidebar_bg_color #$surface;
@define-color sidebar_fg_color #$foreground;
@define-color theme_bg_color #$background;
@define-color theme_fg_color #$foreground;
@define-color theme_base_color #$background;
@define-color theme_text_color #$foreground;
@define-color theme_selected_bg_color #$accent;
@define-color theme_selected_fg_color #$background;
@define-color borders #$dim;
* { border-radius: 0; }
CSS
done
mkdir -p "$HOME/.icons/default"
printf '[Icon Theme]\nName=Default\nInherits=%s\n' "$cursor" > "$HOME/.icons/default/index.theme"

# ---------------------------------------------------------------- 6. recolour open terminals live
seq_out() {
	printf '\033]10;#%s\007\033]11;#%s\007\033]12;#%s\007' "$foreground" "$background" "$accent"
	i=0
	while [ $i -le 15 ]; do
		eval "c=\$color$i"
		printf '\033]4;%s;#%s\007' "$i" "$c"
		i=$((i + 1))
	done
}
for pts in /dev/pts/[0-9]*; do
	[ -O "$pts" ] && [ -w "$pts" ] && seq_out > "$pts" 2>/dev/null || true
done

# ---------------------------------------------------------------- 7. login background (Ly)
if [ -n "$wallpaper" ] && [ -d /etc/ly ] && command -v lilith-ly-bg >/dev/null 2>&1; then
	lilith-ly-bg "$wallpaper" >/dev/null 2>&1 || printf 'lilith-theme: could not make the login background (see lilith-ly-bg)\n' >&2
fi

# ---------------------------------------------------------------- 8. rebuild the compositor
if [ "$BUILD" = 1 ] && [ -d "$LILITH_SRC" ]; then
	if make -C "$LILITH_SRC" >/dev/null 2>"$LILITH_SRC/build.log"; then
		install -Dm755 "$LILITH_SRC/lilith" "$HOME/.local/bin/lilith"
		echo "lilith-theme: compositor rebuilt. Restart the session (Super+Shift+Q) for borders, bar, wallpaper and scale."
	else
		echo "lilith-theme: BUILD FAILED, keeping the old binary. See $LILITH_SRC/build.log" >&2
		exit 1
	fi
fi
echo "lilith-theme: applied (scale ${scale}, font $font $font_size, cursor $cursor $cursor_size, wallpaper ${wallpaper:-none})"
