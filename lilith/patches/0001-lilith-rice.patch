+/* lilith-rice: text of the BarModTitle module (focused window title, or a fallback). */
+static void
+bar_title_update(void)
+{
+	Client *c;
+	const char *t;
+	char buf[BAR_TXT];
+	size_t n;
+
+	if (!bar_modused[BarModTitle])
+		return;
+	c = selmon ? focustop(selmon) : NULL;
+	t = c ? client_get_title(c) : NULL;
+	if (!t || !*t)
+		t = bartitlefallback;
+	n = strlen(t);
+	if (n > (size_t)bartitlemax) {
+		n = bartitlemax;
+		while (n > 0 && ((unsigned char)t[n] & 0xC0) == 0x80)  /* do not cut a UTF-8 character */
+			n--;
+	}
+	if (n > sizeof(buf) - 1)
+		n = sizeof(buf) - 1;
+	memcpy(buf, t, n);
+	buf[n] = '\0';
+	if (bar_setmod(BarModTitle, SchemeTitle, buf))
+		bar_draw_all();
+}
